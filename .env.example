# ============ REQUIRED (API refuses to start without these) ============
DATABASE_URL=            # pooled Postgres URL (Supabase: transaction pooler)
DIRECT_URL=              # direct Postgres URL, used by Prisma migrations
JWT_SECRET=              # Supabase project JWT secret (>= 32 chars). Verifies login tokens.
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000
REDIS_URL=redis://localhost:6379
CACHE_REDIS=false                  # true = cache plan lookups in Redis (shared); false = per-instance memory
THROTTLE_REDIS=false               # true = rate-limit counters in Redis (needed for accurate limits across instances)
SOCKET_REDIS=false                 # true = share Socket.IO across API instances via REDIS_URL (required for >1 instance)
# ============ Supabase (login, storage, account deletion) ============
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=         # server only, never in the frontend
SUPABASE_RESUME_BUCKET=resumes     # create as a PRIVATE bucket
SUPABASE_AVATAR_BUCKET=avatars     # create as a PRIVATE bucket (profile pictures)
# ============ OpenAI (AI answers, analysis, transcription) ============
OPENAI_API_KEY=
OPENAI_MODEL=                      # chat model for analysis/answers (default gpt-4o-mini)
OPENAI_TRANSCRIPTION_MODEL=        # realtime transcription model
OPENAI_REALTIME_MODEL=             # reserved
# ============ Stripe (billing) ============
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=             # endpoint: {BACKEND_URL}/api/v1/billing/webhook
STRIPE_PRICE_PRO_MONTHLY=          # read by `pnpm db:seed`
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_ANNUAL=
STRIPE_TAX=false                   # true = Stripe Tax (automatic VAT/sales tax + tax IDs); enable it in the Stripe dashboard first
# ============ Email (Resend) ============
RESEND_API_KEY=
RESEND_FROM=HireMind <noreply@your-verified-domain>
# ============ Malware scanning (ClamAV clamd) ============
CLAMAV_HOST=                       # unset => uploads are stored as scanStatus=skipped
CLAMAV_PORT=3310
# ============ Data retention ============
TRANSCRIPT_RETENTION_DAYS_DEFAULT=  # optional platform default for users who chose none (unset = keep until deleted)
AI_LOG_RETENTION_DAYS=90            # AI request metadata logs
PDF_FONT_PATH=                     # Unicode TTF for non-Latin text in PDF exports (Docker image sets Noto Sans)
# ============ Monitoring ============
SENTRY_DSN=
# ============ Web app (Vite; build-time) ============
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=                      # backend origin for Socket.IO in production (REST uses /api via proxy/rewrite)
VITE_CONTACT_EMAIL=
VITE_SENTRY_DSN=
# ============ Tests only ============
# E2E_EMAIL= E2E_PASSWORD= E2E_BASE_URL= E2E_LIVE_AI=1
